# ==============================================================================
# SILOTER Backend Environment Variables Template
# ==============================================================================

# Application Settings
PROJECT_NAME="SILOTER Backend"
DEBUG=True
API_V1_STR="/api"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase Credentials (PostgreSQL & Supabase Storage)
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY MUST NEVER be exposed to frontend or Git.
SUPABASE_URL="https://zbgbsffibkuvpazxjlsa.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Active Object Detection Model ("yolov26n_best.pt" or "yolov8_best.pt")
DEFAULT_YOLO_MODEL="yolov26n_best.pt"
MODELS_DIR="models"

# BSW Kota Bogor CCTV Live HLS Streams (.m3u8)
STREAM_URL_EMPANG="https://bsw.kotabogor.go.id/live/empang.m3u8"
STREAM_URL_SURKEN="https://bsw.kotabogor.go.id/live/surken.m3u8"
STREAM_URL_BALAIKOTA="https://bsw.kotabogor.go.id/live/balaikota.m3u8"

# Local Fallback Sample Videos (Used when BSW streams expire or for offline testing)
FALLBACK_VIDEO_EMPANG="data_fallback/empang_sample.mp4"
FALLBACK_VIDEO_SURKEN="data_fallback/surken_sample.mp4"
FALLBACK_VIDEO_BALAIKOTA="data_fallback/balaikota_sample.mp4"

# Loitering Detection Defaults
DEFAULT_THRESHOLD_SECONDS=60
MAX_FPS=1
OCCLUSION_GRACE_SECONDS=5

